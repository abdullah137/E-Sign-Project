# Juripass environment configuration
# Copy to .env.local for local development and fill in your own values.

# Public base URL used in invitation e-mails and public links.
APP_URL=http://localhost:3000

# Directory for the SQLite database and private document storage.
# Defaults to ./data
# SIGNFLOW_DATA_DIR=C:/juripass-data

# Session lifetime in days (default 30)
SESSION_TTL_DAYS=30

# Signing invitation lifetime in days (default 14)
SIGNING_LINK_TTL_DAYS=14

# Upload limit in megabytes (default 5, per product parity)
MAX_UPLOAD_MB=5

# Maximum PDF pages per file (default 100)
MAX_PDF_PAGES=100

# SMTP. When SMTP_HOST is unset, e-mails are written to the development Outbox instead.
# Gmail example: use an App Password, not your normal account password.
# Port 465 uses implicit SSL; port 587 uses STARTTLS. Some networks block 587.
# Replace the placeholders below with your own values. Never commit real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Juripass <no-reply@juripass.local>"

# Set to true to expose /dev/outbox in non-production builds.
SHOW_DEV_OUTBOX=true

# Paystack. Required when a property has an inquiry fee.
# Use the secret key from your Paystack dashboard; never commit real credentials.
# Amounts are sent to Paystack in the smallest currency unit.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=NGN

# Public announcement bar. Set ANNOUNCEMENT_ENABLED=false to hide it.
ANNOUNCEMENT_ENABLED=true
ANNOUNCEMENT_LABEL=NEW
ANNOUNCEMENT_MESSAGE=Tenant inquiries, landlord decisions and signing in one workspace.
ANNOUNCEMENT_HREF=/resources#inquiries
